# Copy this file to .env — never commit .env to git

# Anthropic API key (required for all agent workers)
ANTHROPIC_API_KEY=

# Netlify (required for Publisher worker and CLI deploys)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Site URL (set after first deploy)
SITE_URL=https://[your-site].netlify.app

# Budget thresholds for Cost Monitor
ANTHROPIC_MONTHLY_BUDGET_USD=50
NETLIFY_MONTHLY_BUILD_MINUTES=300
